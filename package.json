{
  "name": "image-workflow",
  "version": "1.3.0",
  "description": "Image-centric workflow for image-heavy notes.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --dev",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint . --max-warnings 0",
    "check": "tsc --noEmit && npm run lint",
    "test": "node tests-image-editor.mjs && node --test tests/copy-images.test.cjs",
    "test:browser": "node tests/browser-verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  }
}
